# ============================================================
# 界外 EdgeReader — 数据库备份 Crontab 配置
# 安装方法: crontab scripts/crontab-backup
# 或追加: crontab -l | cat - scripts/crontab-backup | crontab -
# ============================================================

# 环境变量 (根据实际部署路径修改)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EDGEREADER_HOME=/opt/edgereader

# 每日备份: 每天凌晨 2:00 (UTC) 执行
0 2 * * * cd $EDGEREADER_HOME && bash scripts/db-backup.sh --reason "daily-cron" >> /var/log/edgereader/backup.log 2>&1

# 轮转清理: 每天凌晨 3:00 (UTC) 执行
0 3 * * * cd $EDGEREADER_HOME && bash scripts/db-backup.sh --rotate >> /var/log/edgereader/backup-rotate.log 2>&1

# 备份验证: 每天凌晨 3:30 (UTC) 验证最新备份
30 3 * * * cd $EDGEREADER_HOME && bash scripts/db-backup.sh --verify-latest >> /var/log/edgereader/backup-verify.log 2>&1
